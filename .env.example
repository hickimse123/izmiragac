# ── Zorunlu ─────────────────────────────────────────────────────
# Oturum çerezini imzalamak için rastgele uzun bir metin (en az 32 karakter).
# Üretmek için:  openssl rand -base64 48
APP_SECRET=

# TiDB Cloud → Connect ekranından alınır. Şifredeki özel karakterleri URL-encode edin.
# mysql://KULLANICI:SIFRE@gateway01.<bolge>.prod.aws.tidbcloud.com:4000/VERITABANI
DATABASE_URL=

# ── Dosya depolama (Vercel Blob) ────────────────────────────────
# Vercel → Storage → Blob store'u projeye bağlayınca otomatik eklenir.
# Yerelde çalışmak için:  vercel env pull .env
BLOB_READ_WRITE_TOKEN=

# ── Tür tanıma (Google Gemini) — opsiyonel ──────────────────────
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Model adı kapanabilir/değişebilir; kontrol: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash

# ── Opsiyonel ───────────────────────────────────────────────────
# Bu e-postayla kayıt olan kullanıcı "admin" olur
ADMIN_EMAIL=

# Günlük otomatik tür ekleme (Vercel Cron) için gizli anahtar: rastgele uzun bir metin.
# Üretmek için:  openssl rand -base64 32      (Vercel'de aynı adla Environment Variable olarak ekleyin)
CRON_SECRET=
